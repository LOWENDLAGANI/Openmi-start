rules_version = '2';

// Openmi security rules.
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user quota document.
    // Readable by the owner so the counter can render, but never writable from
    // the browser: credits are charged by the server (Admin SDK) only after a
    // generation succeeds. Clients that try to write are rejected.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Build chats — private to their owner. File contents ride along here so a
    // chat can be reopened; the servable copy lives in Firebase Storage under
    // previews/{chatId}/.
    match /chats/{chatId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.files is list
        && request.resource.data.files.size() <= 12;
      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if false;
    }

    // Published projects. Publicly readable. The owner may republish onto the
    // same id so a shared link stays stable; nobody may delete one.
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.id == projectId
        && (
          request.resource.data.chat_id is string
          || (request.resource.data.code is string && request.resource.data.code.size() < 200000)
        );
      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.id == projectId;
      allow delete: if false;
    }
  }
}
