# ---------------------------------------------------------------------------
# AI generator (server only — never exposed to the browser)
# DeepSeek is the primary provider. Its API is OpenAI-compatible.
# Get a key: https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DeepSeek Flash thinks by default; "disabled" streams UI tokens sooner.
DEEPSEEK_THINKING=disabled
# Output budget for one build, in tokens. Each provider has its own ceiling;
# raise this when yours allows more. A truncated stylesheet is what a
# half-styled page looks like.
AI_MAX_TOKENS=

# --- Optional fallback: any OpenAI-compatible endpoint ---------------------
# Used only when DEEPSEEK_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Live web research (server only)
# Grounds each build in current references, palette ideas and image URLs.
# Optional: without a key, generation still works from the prompt alone.
# Get a key: https://exa.ai  (free credits on signup)
# NOTE: image URLs returned by search are hotlinked into generated pages.
# ---------------------------------------------------------------------------
EXA_API_KEY=

# ---------------------------------------------------------------------------
# Firebase (client SDK — these values are public by design)
# Firebase console → Project settings → Your apps → Web app → Config
# Without these the app stays in demo mode: no accounts, no publishing.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin (server only — NEVER expose these to the browser)
# Enables server-charged quotas: a credit is taken only after a generation
# succeeds, and clients cannot edit their own counter (see firestore.rules).
#
# Preferred: paste the whole service-account JSON from
#   Firebase console → Project settings → Service accounts → Generate new
#   private key — either raw JSON or base64-encoded JSON.
# Or set the three fields individually (keep the \n escapes in the key).
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Bucket that stores generated multi-file projects (previews/<chatId>/...).
# Leave empty to use the project's default bucket.
FIREBASE_STORAGE_BUCKET=
